#!/usr/bin/env python3
"""handoff: move a coding session from one AI agent to another.

Reads the last session of the old agent from disk, saves the raw facts
(your messages and the full transcript) in .handoff/, then starts
the new agent and asks it to write the summary in .handoff/HANDOFF.md.

Usage: handoff <claude|codex|opencode|agy|pi> [--from AGENT] [--no-launch] [--go]
       handoff --clean
"""
import argparse
import datetime
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import urllib.parse
from collections import namedtuple
from functools import partial
from pathlib import Path

# ---------- settings ----------

HOME = Path.home()
CLAUDE_HOME = Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")
CODEX_HOME = Path(os.environ.get("CODEX_HOME") or HOME / ".codex")
OPENCODE_DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / "opencode"
AGY_DIR = HOME / ".gemini/antigravity-cli"
PI_SESSIONS = Path(os.environ.get("PI_CODING_AGENT_SESSION_DIR")
                   or Path(os.environ.get("PI_CODING_AGENT_DIR") or HOME / ".pi/agent") / "sessions")

ALIASES = {"antigravity": "agy", "claude-code": "claude"}
MAX_OUT = 2000  # chars of each tool call / tool output kept in the transcript
FOLDER = ".handoff"

# ---------- prompt for the new agent ----------

PROMPT = """You are taking over a coding session from {old}, another AI agent that hit its usage limit. Do not lose anything important.

1. Read {raw}. It has the user's messages word for word and the full transcript of the last session. If it is long, read the top and the end of the transcript first: the end shows where the work stopped.
2. If .handoff/HANDOFF.md exists, read it too. It has notes from earlier switches, but it may be about an older, different task. Keep only what still matters for the current task.
3. {git_step}
4. Write .handoff/HANDOFF.md with these sections: Goal, Done, Left to do, Decisions and why, Things that failed, User rules and preferences, Key files. If it already exists, update it and keep the important notes from earlier switches. If important files are in /tmp, say so in Key files, since /tmp is deleted on reboot.
5. Tell the user in 2-3 lines where the work stands, then continue the task from where it stopped."""

GIT_STEP = ("Run `git status`, `git diff HEAD` and `git log --oneline -10` to see the real code changes and recent commits "
            "(if there are no commits yet, use `git diff --cached` and `git diff` instead of `git diff HEAD`).")
NO_GIT_STEP = "This folder is not a git repo, so use the transcript to see which files were changed."

# Added in front of PROMPT (unless --go) so the user can pick a model with /model first.
WAIT = """Do not start yet and do not read any files. Reply with exactly this one line and nothing else:
"Ready. Pick a model with /model if you want, then type go."
When the user types go, do the steps below.

"""

# ---------- helpers ----------


def short(s, n=MAX_OUT):
    """Keep the start and the end (errors are often at the end)."""
    s = str(s).strip()
    if len(s) <= n:
        return s
    return s[:n // 2] + f"\n...[{len(s) - n} chars cut]...\n" + s[-n // 2:]


def open_ro(path):
    return sqlite3.connect(f"file:{urllib.parse.quote(str(path))}?mode=ro", uri=True)


def read_jsonl(path):
    """Yield each JSON object of a .jsonl file, skipping broken lines."""
    with open(path, errors="replace") as fh:
        for line in fh:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if isinstance(e, dict):
                yield e


def first_json(path):
    """The first line of a .jsonl file (where the session info is), or {}."""
    with open(path, errors="replace") as fh:
        e = json.loads(fh.readline() or "null")
    return e if isinstance(e, dict) else {}


def parts_text(parts):
    """Join the text of a list of parts like [{"type": "text", "text": ...}]."""
    if isinstance(parts, list):
        return " ".join(x.get("text", "") for x in parts if isinstance(x, dict))
    return parts


# ---------- readers, one per agent ----------
# Each agent has:
#   <agent>_sessions(cwd) -> yields (updated_time, session_ref, loader)
#   loader() -> list of (role, text), role is user / assistant / tool / result


# Claude Code: ~/.claude/projects/<cwd with - >/<id>.jsonl

def claude_sessions(cwd):
    folder = CLAUDE_HOME / "projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)
    for f in folder.glob("*.jsonl"):
        try:
            # different paths can share a folder (my-app and my_app), so check the real cwd
            if claude_cwd(f) == cwd:
                yield f.stat().st_mtime, str(f), partial(claude_load, f)
        except OSError:
            continue


def claude_cwd(path):
    return next((e["cwd"] for e in read_jsonl(path) if e.get("cwd")), None)


def claude_load(path):
    msgs = []
    for e in read_jsonl(path):
        if e.get("type") not in ("user", "assistant") or e.get("isMeta") or e.get("isSidechain") \
                or e.get("isApiErrorMessage"):
            continue
        content = e.get("message", {}).get("content", [])
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        for c in content:
            t = c.get("type")
            if t == "text":
                text = c.get("text", "")
                if e["type"] == "user" and text.lstrip().startswith(("<command-", "<local-command")):
                    continue
                msgs.append((e["type"], text))
            elif t == "tool_use":
                msgs.append(("tool", f'{c.get("name")} {short(json.dumps(c.get("input")))}'))
            elif t == "tool_result":
                msgs.append(("result", short(parts_text(c.get("content") or ""))))
    return msgs


# Codex: ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl

CODEX_INJECTED = ("<environment_context", "<user_instructions", "<codex_internal_context", "<skill",
                  "<turn_aborted", "# AGENTS.md instructions")


def codex_sessions(cwd):
    for f in (CODEX_HOME / "sessions").rglob("rollout-*.jsonl"):
        try:
            if (first_json(f).get("payload") or {}).get("cwd") == cwd:
                yield f.stat().st_mtime, str(f), partial(codex_load, f)
        except (OSError, ValueError, AttributeError):
            continue


def codex_load(path):
    msgs = []
    for e in read_jsonl(path):
        if e.get("type") != "response_item":
            continue
        p = e["payload"]
        t = p.get("type")
        if t == "message" and p.get("role") in ("user", "assistant"):
            for c in p.get("content", []):
                text = c.get("text", "")
                # Codex adds its own context (environment, AGENTS.md, skills) as user messages
                if p["role"] == "user" and text.lstrip().startswith(CODEX_INJECTED):
                    continue
                if text:
                    msgs.append((p["role"], text))
        elif t in ("function_call", "custom_tool_call"):
            msgs.append(("tool", f'{p.get("name")} {short(p.get("arguments") or p.get("input") or "")}'))
        elif t in ("function_call_output", "custom_tool_call_output"):
            out = codex_output(p.get("output", ""))
            if out.strip():
                msgs.append(("result", short(out)))
    return msgs


def codex_output(out):
    """Pull the real text out of a Codex tool output.

    Outputs are a string, or a list of parts like {"type": "input_text", "text": ...}.
    Command results inside a part are JSON: {"output": ..., "exit_code": ...}.
    """
    parts = out if isinstance(out, list) else [{"type": "input_text", "text": out}]
    texts = []
    for part in parts:
        if not isinstance(part, dict):
            continue
        if part.get("type") != "input_text":
            texts.append(f"[{part.get('type')}]")  # e.g. an image
            continue
        text = str(part.get("text", ""))
        if re.fullmatch(r"Script completed\nWall time [\d.]+ seconds\nOutput:\n?", text):
            continue  # wrapper line, says nothing
        d = parse_json(text)
        if d is not None:
            found = json_outputs(d)
            if found or not d:
                texts += found
                continue
        else:
            # JSON lines after a "Warning: truncated output" header; lines cut by Codex stay as they are
            lines = []
            for line in text.split("\n"):
                d = parse_json(line)
                found = json_outputs(d) if d is not None else []
                lines += found or [line]
            text = "\n".join(lines)
        texts.append(text)
    return "\n".join(texts)


def parse_json(text):
    """Return parsed JSON if text is a JSON object or list, else None."""
    if not text.lstrip().startswith(("{", "[")):
        return None
    try:
        d = json.loads(text)
    except ValueError:
        return None
    return d if isinstance(d, (dict, list)) else None


def json_outputs(d):
    """Find command results ({"output": ..., "exit_code": ...}) anywhere in Codex JSON.

    Parallel commands are nested like [{"status": "fulfilled", "value": {"output": ...}}].
    """
    if isinstance(d, dict):
        if isinstance(d.get("output"), str):
            code = d.get("exit_code")
            return [f"(exit code {code})\n{d['output']}" if code else d["output"]]
        if d.get("status") == "rejected":
            return [f"(failed) {d.get('reason')}"]
        if d.get("status") == "fulfilled" and isinstance(d.get("value"), str):
            return [d["value"]]
        return [x for v in d.values() for x in json_outputs(v)]
    if isinstance(d, list):
        found = [json_outputs(v) for v in d]
        if not any(found):
            return []
        # keep items without an output (like errors) as they are
        return [x for v, f in zip(d, found) for x in (f or ([json.dumps(v)] if v else []))]
    return []


# OpenCode: ~/.local/share/opencode/opencode*.db (SQLite)

def opencode_dbs():
    # OPENCODE_DB (relative to the data folder) replaces the default ones,
    # else opencode.db plus opencode-<channel>.db
    custom = os.environ.get("OPENCODE_DB")
    if custom and custom != ":memory:":
        dbs = [OPENCODE_DATA / custom]
    else:
        dbs = sorted(OPENCODE_DATA.glob("opencode*.db"))
    return [db for db in dbs if db.exists()]


def opencode_sessions(cwd):
    for db in opencode_dbs():
        # newer versions use session_v2 + session_message, older use session + message + part
        for table, loader in (("session_v2", opencode_load_v2), ("session", opencode_load_v1)):
            try:
                con = open_ro(db)
                rows = con.execute(f"select id, time_updated from {table} where directory = ? and parent_id is null", (cwd,)).fetchall()
                con.close()
            except sqlite3.Error:
                continue
            for sid, updated in rows:
                yield updated / 1000, f"{db}:{sid}", partial(loader, db, sid)


def opencode_tool(name, state):
    msgs = [("tool", f"{name} {short(json.dumps(state.get('input', {})))}")]
    out = state.get("output") or state.get("error") or state.get("content") or ""
    if isinstance(out, dict):  # errors look like {"type": "aborted", "message": "..."}
        out = out.get("message") or json.dumps(out)
    out = parts_text(out)
    if out:
        msgs.append(("result", short(out)))
    return msgs


def opencode_load_v2(db, sid):
    msgs = []
    con = open_ro(db)
    for typ, data in con.execute("select type, data from session_message where session_id = ? order by seq", (sid,)):
        d = json.loads(data)
        if typ == "user" and d.get("text"):
            msgs.append(("user", d["text"]))
        elif typ == "assistant":
            for c in d.get("content", []):
                if c.get("type") == "text":
                    msgs.append(("assistant", c.get("text", "")))
                elif c.get("type") == "tool":
                    msgs += opencode_tool(c.get("name"), c.get("state", {}))
    con.close()
    return msgs


def opencode_load_v1(db, sid):
    msgs = []
    con = open_ro(db)
    rows = con.execute(
        "select json_extract(m.data, '$.role'), p.data from part p join message m on m.id = p.message_id "
        "where p.session_id = ? order by p.time_created, p.id", (sid,))
    for role, data in rows:
        d = json.loads(data)
        if d.get("type") == "text" and not d.get("synthetic"):
            msgs.append((role, d.get("text", "")))
        elif d.get("type") == "tool":
            msgs += opencode_tool(d.get("tool"), d.get("state", {}))
    con.close()
    return msgs


# Antigravity CLI: ~/.gemini/antigravity-cli (SQLite + protobuf)

def agy_sessions(cwd):
    db = AGY_DIR / "conversation_summaries.db"
    if not db.exists():
        return
    con = open_ro(db)
    rows = con.execute("select conversation_id, last_modified_time, workspace_uris from conversation_summaries "
                       "where parent_conversation_id = ''").fetchall()
    con.close()
    for cid, modified, workspaces in rows:
        try:
            paths = [urllib.parse.unquote(urllib.parse.urlparse(w).path).rstrip("/")
                     for w in json.loads(workspaces or "[]")]
            # time looks like "2026-10-20 13:30:27.839397159+00:00", Python reads at most 6 digits of fraction
            updated = datetime.datetime.fromisoformat(re.sub(r"(\.\d{6})\d+", r"\1", modified)).timestamp()
        except (ValueError, TypeError, AttributeError):
            continue  # skip one broken row, keep looking at the others
        conv = AGY_DIR / "conversations" / f"{cid}.db"
        if cwd in paths and conv.exists():
            yield updated, cid, partial(agy_load, conv)


def pb_varint(b, i):
    result = shift = 0
    while True:
        c = b[i]
        i += 1
        result |= (c & 0x7F) << shift
        shift += 7
        if c < 0x80:
            return result, i


def pb_get(b, field):
    """Return all values of one field in a protobuf message (no schema needed)."""
    values, i = [], 0
    while i < len(b):
        key, i = pb_varint(b, i)
        f, wire = key >> 3, key & 7
        if wire == 0:
            v, i = pb_varint(b, i)
        elif wire == 1:
            v, i = b[i:i + 8], i + 8
        elif wire == 5:
            v, i = b[i:i + 4], i + 4
        elif wire == 2:
            n, i = pb_varint(b, i)
            v, i = b[i:i + n], i + n
        else:
            raise ValueError("unknown wire type")
        if f == field:
            values.append(v)
    return values


def agy_load(path):
    # Found by looking at the data: step type 14 = user input (field 19.2),
    # 15 = model reply (field 20: 1 = text, 7 = tool calls with 2 = name, 3 = args),
    # 132 = tool result (field 140.2.1 = output).
    msgs = []
    con = open_ro(path)
    for step_type, payload in con.execute("select step_type, step_payload from steps order by idx"):
        if not payload:
            continue
        try:
            if step_type == 14:
                for m in pb_get(payload, 19):
                    msgs += [("user", t.decode(errors="replace")) for t in pb_get(m, 2)]
            elif step_type == 15:
                for m in pb_get(payload, 20):
                    msgs += [("assistant", t.decode(errors="replace")) for t in pb_get(m, 1)]
                    for call in pb_get(m, 7):
                        name = b"".join(pb_get(call, 2)).decode(errors="replace")
                        args = b"".join(pb_get(call, 3)).decode(errors="replace")
                        msgs.append(("tool", f"{name} {short(args)}"))
            elif step_type == 132:
                for m in pb_get(payload, 140):
                    for res in pb_get(m, 2):
                        msgs += [("result", short(t.decode(errors="replace"))) for t in pb_get(res, 1)]
        except (ValueError, IndexError, AttributeError, TypeError):
            continue
    con.close()
    return msgs


# pi: ~/.pi/agent/sessions/--<cwd with - >--/<time>_<id>.jsonl

def pi_sessions(cwd):
    for f in PI_SESSIONS.rglob("*.jsonl"):
        try:
            head = first_json(f)
            if head.get("type") == "session" and head.get("cwd") == cwd:
                yield f.stat().st_mtime, str(f), partial(pi_load, f)
        except (OSError, ValueError):
            continue


def pi_load(path):
    entries = [e for e in read_jsonl(path) if e.get("id")]
    by_id = {e["id"]: e for e in entries}
    # a session is a tree (you can go back and branch with /tree), so walk the
    # current branch: from the last entry back to the start through parentId
    branch, seen = [], set()
    e = entries[-1] if entries else None
    while e and e["id"] not in seen:
        seen.add(e["id"])
        branch.append(e)
        e = by_id.get(e.get("parentId"))

    msgs = []
    for e in reversed(branch):
        if e.get("type") == "branch_summary":
            msgs.append(("assistant", "(summary of a branch the user left) " + str(e.get("summary", ""))))
        if e.get("type") != "message":
            continue
        m = e.get("message") or {}
        role, content = m.get("role"), m.get("content")
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        if role in ("user", "assistant"):
            for c in content or []:
                if c.get("type") == "text" and c.get("text"):
                    msgs.append((role, c["text"]))
                elif c.get("type") == "toolCall":
                    msgs.append(("tool", f'{c.get("name")} {short(json.dumps(c.get("arguments")))}'))
        elif role == "toolResult":
            out = parts_text(content)
            if out:
                msgs.append(("result", short(("(error) " if m.get("isError") else "") + out)))
        elif role == "bashExecution":  # a command the user ran with !
            msgs.append(("tool", f"bash (run by the user) {short(m.get('command', ''))}"))
            msgs.append(("result", short(m.get("output", ""))))
    return msgs


# ---------- all agents ----------

Agent = namedtuple("Agent", "sessions launch")
AGENTS = {
    "claude": Agent(claude_sessions, lambda p: ["claude", p]),
    "codex": Agent(codex_sessions, lambda p: ["codex", p]),
    "opencode": Agent(opencode_sessions, lambda p: ["opencode", "--prompt", p]),
    "agy": Agent(agy_sessions, lambda p: ["agy", "-i", p]),
    "pi": Agent(pi_sessions, lambda p: ["pi", p]),
}


def find_session(cwd, agents):
    """Newest session in cwd, from the given agents, that has at least one user message."""
    found = []
    for agent in agents:
        try:
            for t, ref, load in AGENTS[agent].sessions(cwd):
                found.append((t, agent, ref, load))  # keep what was found even if a later file fails
        except (OSError, sqlite3.Error, ValueError) as e:
            print(f"warning: could not read all {agent} sessions: {e}", file=sys.stderr)
    for t, agent, ref, load in sorted(found, key=lambda x: x[0], reverse=True):
        try:
            msgs = load()
        except (OSError, sqlite3.Error, ValueError, AttributeError, TypeError, KeyError) as e:
            print(f"warning: could not read {ref}: {e}", file=sys.stderr)
            continue
        if any(role == "user" for role, _ in msgs):
            return agent, ref, t, msgs
    return None


# ---------- the handoff file ----------

def git(cwd, *args):
    try:
        r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, errors="replace")
    except FileNotFoundError:  # git is not installed
        return None
    return r.stdout.rstrip() if r.returncode == 0 else None


def is_git_repo(cwd):
    return git(cwd, "rev-parse", "--is-inside-work-tree") == "true"


def write_raw(cwd, old, new, ref, msgs):
    now = datetime.datetime.now()
    user_msgs = [text for role, text in msgs if role == "user"]
    replies = [text for role, text in msgs if role == "assistant"]

    out = [f"# Handoff: {old} -> {new}", "",
           f"- Time: {now:%Y-%m-%d %H:%M}", f"- Project: {cwd}", f"- Old session: {ref}", "",
           "## User messages (word for word)", ""]
    for i, text in enumerate(user_msgs, 1):
        out += [f"### {i}", text.strip("\r\n"), ""]
    out += [f"## Last reply from {old}", "", replies[-1].strip() if replies else "(none)", ""]
    labels = {"user": "**User:**", "assistant": f"**{old}:**", "tool": "`tool`", "result": "> result:"}
    out += ["## Full transcript", ""]
    for role, text in msgs:
        out += [labels[role] + " " + text.strip("\r\n"), ""]

    return save_new_file(Path(cwd) / FOLDER, f"{now:%Y-%m-%d_%H-%M-%S}_{old}-to-{new}", "\n".join(out))


def save_new_file(folder, name, text):
    """Save as <name>.md, or <name>-2.md, ... if it exists, so two runs never overwrite."""
    folder.mkdir(exist_ok=True)
    n = 1
    while True:
        path = folder / f"{name}{'' if n == 1 else f'-{n}'}.md"
        try:
            with open(path, "x") as fh:  # "x" fails if the file exists
                fh.write(text)
            return path
        except FileExistsError:
            n += 1


def ignore_in_git(cwd):
    """Add .handoff/ to .git/info/exclude so transcripts are never committed (local only)."""
    exclude = git(cwd, "rev-parse", "--git-path", "info/exclude")
    if not exclude:
        return
    exclude = Path(cwd) / exclude
    text = exclude.read_text() if exclude.exists() else ""
    if ".handoff/" not in text.split("\n"):
        exclude.parent.mkdir(parents=True, exist_ok=True)
        exclude.write_text(text + ("" if text.endswith("\n") or not text else "\n") + ".handoff/\n")


# ---------- commands ----------

def clean(cwd):
    """Delete .handoff/ after the user types y."""
    folder = Path(cwd) / FOLDER
    if not folder.is_dir():
        print(f"nothing to clean: no {FOLDER}/ folder here")
        return
    files = [f for f in folder.rglob("*") if f.is_file()]
    print(f"This deletes {folder} ({len(files)} files): all saved chats and HANDOFF.md.")
    try:
        answer = input("Delete it? [y/N] ")
    except EOFError:  # no keyboard input (e.g. piped), so don't delete
        answer = ""
    if answer.strip().lower() in ("y", "yes"):
        shutil.rmtree(folder)
        print(f"deleted {FOLDER}/")
    else:
        print("cancelled, nothing deleted")


def handoff(cwd, new, src, go, launch):
    found = find_session(cwd, [src] if src else [a for a in AGENTS if a != new])
    if not found:
        sys.exit(f"no session found for {cwd}")
    old, ref, updated, msgs = found
    print(f"from: {old}  ({ref}, last active {datetime.datetime.fromtimestamp(updated):%Y-%m-%d %H:%M})")

    raw = write_raw(cwd, old, new, ref, msgs)
    ignore_in_git(cwd)
    print(f"saved: {raw.relative_to(cwd)}")

    prompt = PROMPT.format(old=old, raw=raw.relative_to(cwd), git_step=GIT_STEP if is_git_repo(cwd) else NO_GIT_STEP)
    if not go:
        prompt = WAIT + prompt
    if not launch:
        print("\nprompt:\n" + prompt)
        return
    cmd = AGENTS[new].launch(prompt)
    print(f"starting {new}...")
    sys.stdout.flush()  # exec replaces this process, unflushed output would be lost
    try:
        os.execvp(cmd[0], cmd)
    except FileNotFoundError:
        sys.exit(f"{cmd[0]} is not installed or not in PATH")


def main():
    ap = argparse.ArgumentParser(description="Move your session to another AI agent.")
    ap.add_argument("to", nargs="?", help="agent to switch to: " + ", ".join(AGENTS))
    ap.add_argument("--from", dest="src", help="agent to take the session from (default: newest session here)")
    ap.add_argument("--no-launch", action="store_true", help="only write the handoff file and print the prompt")
    ap.add_argument("--go", action="store_true", help="start working right away (skip the wait to pick a model)")
    ap.add_argument("--clean", action="store_true", help=f"delete the {FOLDER}/ folder here (asks first)")
    args = ap.parse_args()

    if args.clean:
        if args.to:
            ap.error("--clean does not take an agent")
        return clean(os.getcwd())
    if not args.to:
        ap.error("choose the agent to switch to: " + ", ".join(AGENTS))

    new = ALIASES.get(args.to, args.to)
    src = ALIASES.get(args.src, args.src)
    for name in (new, src):
        if name and name not in AGENTS:
            sys.exit(f"unknown agent: {name} (use one of: {', '.join(AGENTS)})")
    handoff(os.getcwd(), new, src, args.go, not args.no_launch)


if __name__ == "__main__":
    main()
